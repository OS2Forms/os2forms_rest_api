{
    "name": "os2forms/os2forms_rest_api",
    "description": "OS2Forms REST API",
    "license": "MIT",
    "type": "drupal-module",
    "authors": [
        {
            "name": "Mikkel Ricky",
            "email": "rimi@aarhus.dk"
        }
    ],
    "require": {
        "cweagans/composer-patches": "^1.7",
        "drupal/key_auth": "^2.0",
        "drupal/webform_rest": "^4.2",
        "os2forms/os2forms": "^4.0 || ^5.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.2",
        "drupal/coder": "^8.3",
        "ergebnis/composer-normalize": "^2",
        "mglaman/drupal-check": "^1.4",
        "mglaman/phpstan-drupal": "~1.2.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "mglaman/composer-drupal-lenient": true,
            "simplesamlphp/composer-module-installer": true,
            "simplesamlphp/composer-xmlprovider-installer": true,
            "zaporylie/composer-drupal-optimizations": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-lenient": {
            "allowed-list": [
                "drupal/webform_node_element"
            ]
        },
        "enable-patching": true,
        "patches": {
            "drupal/webform_rest": {
                "Added ability to modify response data sent from Webform Submission endpoint": "https://raw.githubusercontent.com/OS2Forms/os2forms_rest_api/2.4.0/patches/webform_rest_submission.patch"
            }
        }
    },
    "scripts": {
        "code-analysis": [
            "@code-analysis/drupal-check"
        ],
        "code-analysis/drupal-check": [
            "vendor/bin/drupal-check --deprecations --analysis --exclude-dir=vendor *.* src"
        ],
        "coding-standards-apply": [
            "@coding-standards-apply/phpcs"
        ],
        "coding-standards-apply/phpcs": [
            "vendor/bin/phpcbf --standard=phpcs.xml.dist"
        ],
        "coding-standards-check": [
            "@coding-standards-check/phpcs"
        ],
        "coding-standards-check/phpcs": [
            "vendor/bin/phpcs --standard=phpcs.xml.dist"
        ]
    }
}
